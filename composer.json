{
    "name": "alt-design/alt-commerce",
    "description": "Ecommerce core for PHP with baskets, tax, coupons, orders, stock and Stripe payments. Not tied to a framework.",
    "license": "MIT",
    "keywords": [
        "ecommerce",
        "basket",
        "checkout",
        "orders",
        "stripe"
    ],
    "authors": [
        {
            "name": "Alt Design",
            "homepage": "https://alt-design.net"
        }
    ],
    "support": {
        "email": "support@alt-design.net",
        "issues": "https://github.com/alt-design/alt-commerce/issues"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "nesbot/carbon": "^3",
        "ramsey/uuid": "^4.7",
        "braintree/braintree_php": "^6.21",
        "stripe/stripe-php": "^17.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.22|^13.1.6",
        "mockery/mockery": "^1",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-mockery": "^2.0",
        "fakerphp/faker": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "AltDesign\\AltCommerce\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AltDesign\\AltCommerce\\Tests\\": "tests"
        }
    },
    "extra": {
    }
}
